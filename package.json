{
  "name": "pmi-datahelp-portal",
  "version": "2.0.0",
  "description": "PMI-DataHelp educational portal + Morris PMO corporate dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:phase1": "tsc && vite build --mode phase1",
    "build:phase2": "tsc && vite build --mode phase2",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest --run",
    "test:watch": "vitest",
    "deploy:dev": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-dev.ps1",
    "deploy:prod": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-prod.ps1",
    "deploy:infrastructure": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-infrastructure.ps1",
    "deploy:application": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-application.ps1",
    "setup:cicd": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-cicd.ps1",
    "manage:pipeline": "powershell -ExecutionPolicy Bypass -File ./scripts/manage-pipeline.ps1",
    "retire:old-distributions": "powershell -ExecutionPolicy Bypass -File ./scripts/retire-old-distributions.ps1",
    "validate": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "lucide-react": "^0.292.0",
    "recharts": "^2.8.0",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.1.1",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/jest-dom": "^6.1.4",
    "tailwindcss": "^3.3.5",
    "postcss": "^8.4.31",
    "autoprefixer": "^10.4.16",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@tailwindcss/aspect-ratio": "^0.4.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}