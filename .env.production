# PMI-DataHelp - Ambiente de Producción
VITE_APP_VERSION=2.0.0
VITE_APP_ENVIRONMENT=production
VITE_APP_TITLE=PMI-DataHelp

# API Configuration
VITE_API_BASE_URL=https://api.pmi-datahelp.com

# Authentication (Simplified)
VITE_AUTH_MODE=simple
VITE_ADMIN_USER=dbarrios
VITE_ENABLE_REGISTRATION=false

# Feature Flags
VITE_ENABLE_PMO_PORTAL=true
VITE_ENABLE_HELP_PORTAL=true
VITE_ENABLE_ANALYTICS=true
VITE_MOCK_DATA=false

# Production Settings
VITE_DEBUG_MODE=false
VITE_SHOW_DEV_INFO=false