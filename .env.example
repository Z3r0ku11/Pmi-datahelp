# PMI-DataHelp Environment Configuration
# Copy this file to .env and configure with your actual values

# Application Configuration
VITE_APP_VERSION=2.0.0
VITE_APP_ENVIRONMENT=development
VITE_API_BASE_URL=https://api.pmi-datahelp.com

# AWS Cognito Configuration
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_DOMAIN=pmi-datahelp-auth

# Phase 1 Configuration (Public Portal)
VITE_COGNITO_PHASE1_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Phase 2 Configuration (PMO Dashboard)
VITE_COGNITO_PHASE2_CLIENT_ID=yyyyyyyyyyyyyyyyyyyyyyyyyy

# Google OAuth Configuration (Optional)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.googleusercontent.com

# AWS S3 Configuration (for assets)
VITE_S3_BUCKET_PHASE1=pmi-datahelp-phase1-prod-664858858204
VITE_S3_BUCKET_PHASE2=pmi-datahelp-phase2-prod-664858858204
VITE_S3_REGION=us-east-1

# CloudFront Distribution IDs
VITE_CLOUDFRONT_PHASE1_DISTRIBUTION_ID=EXXXXXXXXXXXXX
VITE_CLOUDFRONT_PHASE2_DISTRIBUTION_ID=EYYYYYYYYYYY

# Analytics Configuration (Optional)
VITE_GA_TRACKING_ID=G-XXXXXXXXXX
VITE_HOTJAR_ID=XXXXXXX

# Feature Flags
VITE_ENABLE_GOOGLE_AUTH=true
VITE_ENABLE_SSO=false
VITE_ENABLE_MFA=false
VITE_MAINTENANCE_MODE=false

# Development Configuration
VITE_DEBUG_MODE=false
VITE_MOCK_AUTH=true