# PMI-DataHelp - Ambiente de Desarrollo
VITE_APP_VERSION=2.0.0
VITE_APP_ENVIRONMENT=development
VITE_APP_TITLE=PMI-DataHelp (DEV)

# API Configuration
VITE_API_BASE_URL=https://api-dev.pmi-datahelp.com

# Authentication (Simplified)
VITE_AUTH_MODE=simple
VITE_ADMIN_USER=dbarrios
VITE_ENABLE_REGISTRATION=true

# Feature Flags
VITE_ENABLE_PMO_PORTAL=true
VITE_ENABLE_HELP_PORTAL=true
VITE_ENABLE_ANALYTICS=true
VITE_MOCK_DATA=true

# Development Settings
VITE_DEBUG_MODE=true
VITE_SHOW_DEV_INFO=true